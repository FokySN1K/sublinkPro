# SublinkPro instance the checker talks to.
SUBLINK_URL=http://host.docker.internal:8000
# API key with node read and tag write scopes (Settings -> API keys).
SUBLINK_API_KEY=

# Comma separated services; empty means every provider.
# Known keys: chatgpt (alias openai), claude, gemini, copilot, perplexity,
# grok, mistral, deepseek, qwen, poe.
SERVICES=

# Tags are "<TAG_PREFIX><service>" when the service is available from the exit
# and "<TAG_PREFIX><service>-blocked" when the service explicitly refuses the
# region. An unknown verdict never touches the node.
TAG_PREFIX=ai-

# How often every node is re-checked. 90, 15m, 6h, 1d are all valid.
CHECK_INTERVAL=6h
RUN_ON_START=true
# One cycle, then exit (handy for a manual run inside the container).
ONCE=false

# Node selection: keep nodes that carry at least one ONLY_TAGS entry, drop nodes
# that carry any SKIP_TAGS entry, then cap the rest with MAX_NODES.
ONLY_TAGS=
SKIP_TAGS=
MAX_NODES=0

# Each worker owns a mihomo process; 1 is enough for a few hundred nodes.
WORKERS=1
# Create the tags automatically when they do not exist yet.
ENSURE_TAG=true
# Log the tag diff without writing it.
DRY_RUN=false

# Per-request timeout, seconds. A node that cannot carry traffic at all is
# dropped earlier by the mihomo reachability check (6 s).
PROBE_TIMEOUT=15
# Any 2xx/3xx/204 answer proves the node works; override if your exits cannot
# reach gstatic.
REACHABILITY_URL=https://www.gstatic.com/generate_204
# Optional UA override for our own diagnostics; empty keeps the built-in Chrome UA.
PROBE_USER_AGENT=

LOG_LEVEL=info
