# Copy to .env and adjust.

# --- SublinkPro -------------------------------------------------------------
# Base URL of the SublinkPro instance (no trailing /api).
SUBLINK_URL=http://host.docker.internal:8000
# Access key created in SublinkPro (Settings -> Access Keys), sent as X-API-Key.
SUBLINK_API_KEY=

# --- Tagging ----------------------------------------------------------------
# Which service to check: youtube (headful Chromium) or rutube (JSON only).
SERVICE=youtube
# Each service has its own mutually exclusive pair: ad-free nodes get the clean
# tag and lose the ads tag, ad-serving nodes get the ads tag and lose the clean
# tag. Unreachable nodes keep whatever they had. Both tags are created
# automatically (ENSURE_TAG=true).
YOUTUBE_TAG=youtube
YOUTUBE_ADS_TAG=youtube-ads
RUTUBE_TAG=rutube
RUTUBE_ADS_TAG=rutube-ads
ENSURE_TAG=true
# Log the decisions without touching tags.
DRY_RUN=false

# --- Schedule ---------------------------------------------------------------
# 30m, 6h, 1d, 1h30m or plain seconds. If a cycle runs longer than this, the
# missed cycles are skipped (never run in parallel).
CHECK_INTERVAL=6h
RUN_ON_START=true
# Run a single cycle and exit (a manual run). Ignored by the scheduler.
ONCE=false

# --- Node subset ------------------------------------------------------------
# Only check nodes that carry at least one of these tags (comma separated,
# case-insensitive). Empty means every node.
ONLY_TAGS=
# Never check nodes that carry any of these tags.
SKIP_TAGS=
# Stop after this many nodes (0 = no limit). Useful for a quick smoke test.
MAX_NODES=0

# --- Concurrency ------------------------------------------------------------
# Probe this many nodes at once. Each worker runs its own mihomo (ports
# MIHOMO_PROXY_PORT + i) and its own Chromium, so budget ~1 GB RAM per worker.
WORKERS=1

# --- Probe ------------------------------------------------------------------
# YouTube only: comma separated videos to probe. The first one is watched in
# full; the others are only checked for an ad schedule and can turn a clean
# verdict into "ads", which protects against a demonetized video. A bare id and
# watch?v=... are both accepted. Empty means the built-in list; PROBE_URL with a
# single video still works as an alias.
YOUTUBE_VIDEOS=
# Total budget per node, seconds.
PROBE_TIMEOUT=45
# How long to watch the player for ad markers after it loads, seconds.
PROBE_DWELL=10
# Run Chromium without a virtual display (not recommended: YouTube treats
# headless browsers differently).
HEADLESS=false
# Rutube only: monetized video ids used as probes (comma separated). Empty means
# the built-in list; a video that lost its ads is skipped automatically.
RUTUBE_VIDEOS=

# --- Diagnostics ------------------------------------------------------------
LOG_LEVEL=info
