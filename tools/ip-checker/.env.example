# SublinkPro instance the checker talks to.
SUBLINK_URL=http://host.docker.internal:8000
# API key with node read and tag write scopes (Settings -> API keys).
SUBLINK_API_KEY=

# Comma separated IP reputation sources.
# Keyless and enabled by default: iplocate (privacy block), ipapi (hosting/proxy).
# Optional, off unless listed: proxycheck (works keyless, 100/day), ipqualityscore,
# vpnapi (both need a key). Empty means the two keyless sources.
SOURCES=

# The node gets this tag when every checked link looks like a clean residential
# address. It is removed when a source recognises a VPN, proxy, Tor or hosting
# network. An unknown answer leaves the tag untouched.
CLEAN_TAG=clean-ip

# Free-tier keys. proxycheck.io works without one; IPQS and vpnapi require it.
IPLOCATE_API_KEY=
PROXYCHECK_KEY=
IPQUALITYSCORE_KEY=
VPNAPI_KEY=

# How often every node is re-checked. 90, 15m, 24h, 1d are all valid.
CHECK_INTERVAL=24h
RUN_ON_START=true
# One cycle, then exit (handy for a manual run inside the container).
ONCE=false

# Node selection: keep nodes that carry at least one ONLY_TAGS entry, drop nodes
# that carry any SKIP_TAGS entry, then cap the rest with MAX_NODES.
ONLY_TAGS=
SKIP_TAGS=
MAX_NODES=0

# How many sources must answer "clean" before the tag is written. Set it to the
# number of enabled sources to demand that all of them agree.
REQUIRE_CLEAN=1

# Each worker owns a mihomo process; 1 is enough for a few hundred nodes.
WORKERS=1
# Create the tag automatically when it does not exist yet.
ENSURE_TAG=true
# Log the tag diff without writing it.
DRY_RUN=false

# Per-request timeout, seconds. A node that cannot carry traffic at all is
# dropped earlier by the mihomo reachability check (6 s).
PROBE_TIMEOUT=15
# Endpoints used to read the exit address through the node; the first one is
# configurable, two public fallbacks follow it automatically.
EXIT_IP_URL=https://api.ipify.org?format=json
# Any 2xx/3xx/204 answer proves the node works; override if your exits cannot
# reach gstatic.
REACHABILITY_URL=https://www.gstatic.com/generate_204

LOG_LEVEL=info
